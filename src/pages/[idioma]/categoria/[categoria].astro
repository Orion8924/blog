---
import PaginaCategoria from '../../../components/PaginaCategoria.astro';
import { CATEGORIAS } from '../../../content.config';
import { IDIOMAS_SECUNDARIOS, type Idioma } from '../../../i18n';

export function getStaticPaths() {
  return IDIOMAS_SECUNDARIOS.flatMap((idioma) => CATEGORIAS.map((categoria) => ({ params: { idioma, categoria } })));
}
const { idioma, categoria } = Astro.params as { idioma: Idioma; categoria: (typeof CATEGORIAS)[number] };
---
<PaginaCategoria idioma={idioma} categoria={categoria} />
