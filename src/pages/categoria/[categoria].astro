---
import PaginaCategoria from '../../components/PaginaCategoria.astro';
import { CATEGORIAS } from '../../content.config';

export async function getStaticPaths() {
  return CATEGORIAS.map((categoria) => ({ params: { categoria } }));
}
const { categoria } = Astro.params as { categoria: (typeof CATEGORIAS)[number] };
---
<PaginaCategoria idioma="es" categoria={categoria} />
