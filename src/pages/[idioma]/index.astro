---
import Portada from '../../components/Portada.astro';
import { IDIOMAS_SECUNDARIOS, type Idioma } from '../../i18n';

export function getStaticPaths() {
  return IDIOMAS_SECUNDARIOS.map((idioma) => ({ params: { idioma } }));
}
const { idioma } = Astro.params as { idioma: Idioma };
---
<Portada idioma={idioma} />
