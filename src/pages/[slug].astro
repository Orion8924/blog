---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { NOMBRES_CATEGORIA } from '../content.config';

export async function getStaticPaths() {
  const articulos = await getCollection('blog', ({ data }) => !data.borrador);
  return articulos.map((a) => ({ params: { slug: a.id }, props: { articulo: a } }));
}

const { articulo } = Astro.props;
const { Content } = await render(articulo);
const base = import.meta.env.BASE_URL;
const d = articulo.data;
const fecha = d.fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base titulo={`${d.titulo} — Emilio Ávila`} descripcion={d.resumen} imagen={d.imagen} categoriaActual={d.categoria}>
  <article>
    <header class="articulo-cabecera">
      <div class="meta"><a href={`${base}categoria/${d.categoria}/`}>{NOMBRES_CATEGORIA[d.categoria]}</a> — <time datetime={d.fecha.toISOString()}>{fecha}</time></div>
      <h1>{d.titulo}</h1>
      <p class="resumen">{d.resumen}</p>
    </header>
    <figure class="foto-grande">
      <img src={`${base}${d.imagen.replace(/^\//, '')}`} alt={d.imagenAlt} />
      {d.imagenCredito && <figcaption>{d.imagenCredito}</figcaption>}
    </figure>
    <div class="prosa"><Content /></div>
  </article>
</Base>
