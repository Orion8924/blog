---
import { getCollection } from 'astro:content';
import { CATEGORIAS_I18N, formatearFecha, partirId, prefijo, type Idioma } from '../i18n';

interface Props { idioma: Idioma; categoria?: string; mostrarCategoria?: boolean }
const { idioma, categoria, mostrarCategoria = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const articulos = (await getCollection('blog', ({ id, data }) =>
  !data.borrador && partirId(id).idioma === idioma && (categoria === undefined || data.categoria === categoria)
)).sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());
---
{articulos.map((a) => (
  <a class="entrada" href={`${base}${prefijo(idioma)}${partirId(a.id).slug}/`}>
    <img src={/^https?:/.test(a.data.imagen) ? a.data.imagen : `${base}${a.data.imagen.replace(/^\//, '')}`} alt={a.data.imagenAlt} loading="lazy" />
    <h2>{a.data.titulo}</h2>
    <p>{a.data.resumen}</p>
    <div class="meta">{mostrarCategoria ? `${CATEGORIAS_I18N[idioma][a.data.categoria]} — ` : ''}{formatearFecha(a.data.fecha, idioma)}</div>
  </a>
))}
{articulos.length === 0 && <slot />}
