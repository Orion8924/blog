---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORIAS_I18N, formatearFecha, partirId, prefijo, type Idioma } from '../i18n';

interface Props { articulo: CollectionEntry<'blog'> }
const { articulo } = Astro.props;
const { Content } = await render(articulo);
const base = import.meta.env.BASE_URL;
const d = articulo.data;
const { idioma, slug } = partirId(articulo.id);
const fecha = formatearFecha(d.fecha, idioma);

// Versiones de este mismo artículo en otros idiomas: mismo slug en otra carpeta.
const versiones = await getCollection('blog', ({ id, data }) => !data.borrador && partirId(id).slug === slug);
const alternativas: Partial<Record<Idioma, string>> = {};
for (const v of versiones) {
  const { idioma: i } = partirId(v.id);
  alternativas[i] = `${prefijo(i)}${slug}/`;
}
---
<Base titulo={`${d.titulo} — Emilio Ávila`} descripcion={d.resumen} imagen={d.imagen} categoriaActual={d.categoria} idioma={idioma} alternativas={alternativas}>
  <article>
    <header class="articulo-cabecera">
      <div class="meta"><a href={`${base}${prefijo(idioma)}categoria/${d.categoria}/`}>{CATEGORIAS_I18N[idioma][d.categoria]}</a> — <time datetime={d.fecha.toISOString()}>{fecha}</time></div>
      <h1>{d.titulo}</h1>
      <p class="resumen">{d.resumen}</p>
    </header>
    <figure class="foto-grande">
      <img src={`${base}${d.imagen.replace(/^\//, '')}`} alt={d.imagenAlt} />
      {d.imagenCredito && <figcaption>{d.imagenCredito}</figcaption>}
    </figure>
    <div class="prosa"><Content /></div>
  </article>
</Base>
