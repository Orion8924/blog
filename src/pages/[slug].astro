---
import { getCollection } from 'astro:content';
import Articulo from '../components/Articulo.astro';
import { partirId } from '../i18n';

export async function getStaticPaths() {
  const articulos = await getCollection('blog', ({ id, data }) => !data.borrador && partirId(id).idioma === 'es');
  return articulos.map((a) => ({ params: { slug: partirId(a.id).slug }, props: { articulo: a } }));
}
const { articulo } = Astro.props;
---
<Articulo articulo={articulo} />
