---
import '../styles/global.css';
import { CATEGORIAS, NOMBRES_CATEGORIA } from '../content.config';

interface Props { titulo: string; descripcion?: string; imagen?: string; categoriaActual?: string; }
const { titulo, descripcion = 'Artículos de Emilio Ávila', imagen, categoriaActual } = Astro.props;
const base = import.meta.env.BASE_URL;
const ogImagen = imagen ? new URL(base + imagen.replace(/^\//, ''), Astro.site) : undefined;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {ogImagen && <meta property="og:image" content={ogImagen} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;1,7..72,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="cabecera">
      <a class="marca" href={base}>Emilio Ávila</a>
      <nav class="categorias" aria-label="Categorías">
        {CATEGORIAS.map((c) => (
          <a href={`${base}categoria/${c}/`} aria-current={c === categoriaActual ? 'page' : undefined}>{NOMBRES_CATEGORIA[c]}</a>
        ))}
      </nav>
    </header>
    <slot />
    <footer class="pie">
      <span>© {new Date().getFullYear()} Emilio Ávila</span>
      <span>Hecho con Astro</span>
    </footer>
  </body>
</html>
